# Copy to .env and fill in real values, or let scripts/local_mysql.ps1 generate both files.
# Never commit the real .env / .env.test.

# Development database (isolated instance only, 127.0.0.1:33307, database claim_dev)
DATABASE_URL=mysql+pymysql://claim_app:CHANGE_ME@127.0.0.1:33307/claim_dev?charset=utf8mb4

# Test database (same instance, database claim_test)
TEST_DATABASE_URL=mysql+pymysql://claim_app:CHANGE_ME@127.0.0.1:33307/claim_test?charset=utf8mb4

# 64 hex chars; signs bearer tokens and derives handover codes when HANDOVER_SECRET is absent
AUTH_SECRET=CHANGE_ME_64_HEX_CHARS
# Optional separate key for handover-code derivation
# HANDOVER_SECRET=CHANGE_ME_64_HEX_CHARS

# Demo identity endpoint POST /v1/demo/token is only enabled when this is true
DEMO_MODE=false
